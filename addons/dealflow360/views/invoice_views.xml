<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DF-013 (Invoices half): Screens 12/13. Pure native account.move - no
         missing fields per ui_spec.md. Reuses account's own tree/form/search
         views (already has Unpaid/Paid filters and a payment_state badge)
         instead of rebuilding them. Only adds: the action+domain, a compact
         status widget on the form (see invoice_stepper/), and wires
         menu_dealflow_invoices's action from this file rather than editing
         views/dealflow_menus.xml (Atlas's DF-003c carve-out). -->
    <record id="action_dealflow_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="views" eval="[(ref('account.view_out_invoice_tree'), 'tree'),
                                    (ref('account.view_move_form'), 'form')]"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="menu_dealflow_invoices" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_dealflow_invoices')"/>
    </record>

    <record id="view_move_form_dealflow_stepper" model="ir.ui.view">
        <field name="name">account.move.form.dealflow.stepper</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="o_df_invoice_stepper_wrap" invisible="move_type != 'out_invoice'">
                    <field name="payment_state" widget="dealflow_invoice_stepper" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
