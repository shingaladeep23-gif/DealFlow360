<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscriptions (Screen 9). The menu action now points at the OWL
         screen (static/src/subscriptions/) over sale.order.line's real
         df_sub_state/df_sub_next_bill_date/df_mrr (DEC-008: one recurring
         line IS one subscription - no separate lifecycle model). The
         dealflow.billing.schedule tree/form below is kept as a plain
         per-event drill-down (accessible via the order form's Billing
         Schedule tab / smart button already on sale.order.line), not the
         Subscriptions landing page anymore. -->
    <record id="action_dealflow_subscriptions_screen" model="ir.actions.client">
        <field name="name">Subscriptions</field>
        <field name="tag">dealflow_subscriptions</field>
    </record>
    <record id="view_billing_schedule_list" model="ir.ui.view">
        <field name="name">dealflow.billing.schedule.list</field>
        <field name="model">dealflow.billing.schedule</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'invoiced'">
                <field name="order_id"/>
                <field name="order_line_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="amount" widget="monetary"/>
                <field name="df_is_proration"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-info="state == 'pending'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_billing_schedule_form" model="ir.ui.view">
        <field name="name">dealflow.billing.schedule.form</field>
        <field name="model">dealflow.billing.schedule</field>
        <field name="arch" type="xml">
            <form string="Billing Schedule Entry">
                <sheet>
                    <group col="2">
                        <field name="order_id" readonly="1"/>
                        <field name="order_line_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="date"/>
                        <field name="amount" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="df_is_proration"/>
                        <field name="state" widget="badge"
                               decoration-success="state == 'invoiced'"
                               decoration-info="state == 'pending'"
                               decoration-muted="state == 'cancelled'"/>
                        <field name="invoice_id" readonly="1"/>
                    </group>
                    <button name="action_invoice_now" type="object" string="Generate Invoice Now"
                            class="btn-primary" invisible="state != 'pending'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_billing_schedule_search" model="ir.ui.view">
        <field name="name">dealflow.billing.schedule.search</field>
        <field name="model">dealflow.billing.schedule</field>
        <field name="arch" type="xml">
            <search string="Subscriptions">
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dealflow_billing_schedule" model="ir.actions.act_window">
        <field name="name">Billing Schedule</field>
        <field name="res_model">dealflow.billing.schedule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_billing_schedule_search"/>
    </record>

    <menuitem id="menu_dealflow_subscriptions"
              parent="menu_dealflow_root"
              action="action_dealflow_subscriptions_screen"
              sequence="50"/>
</odoo>
