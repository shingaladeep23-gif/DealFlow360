<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Minimal settings panel exposing DEC-010's configurable routing
         threshold. Mockup screen 18 shows this as a panel with a Save
         button - native res.config.settings gives us that for free. -->
    <record id="res_config_settings_view_form_dealflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dealflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="DealFlow360" string="DealFlow360" data-key="dealflow360">
                    <h2>Discount approvals</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="dealflow_default_max_discount"/>
                                <div class="text-muted">
                                    The discount limit for a line when neither the customer's tier nor the product's category sets one. A tier or category left at 0 counts as unset, not as "no discount allowed".
                                </div>
                                <field name="dealflow_default_max_discount"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="dealflow_risk_high_min"/>
                                <div class="text-muted">
                                    How far over the discount limit a quotation has to go before finance has to sign off too. Above this score a deal needs a sales manager and then finance; at or below it, just a sales manager.
                                </div>
                                <field name="dealflow_risk_high_min"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
