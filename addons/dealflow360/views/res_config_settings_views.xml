<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Minimal settings panel exposing DEC-010's configurable routing
         threshold. Mockup screen 18 shows this as a panel with a Save
         button - native res.config.settings gives us that for free. -->
    <record id="res_config_settings_view_form_dealflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dealflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="DealFlow360" string="DealFlow360" data-key="dealflow360">
                    <h2>Discount Risk Routing</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="dealflow_risk_high_min"/>
                                <div class="text-muted">
                                    Blended risk scores above this value route HIGH (Sales Manager then Finance); at or below it (and above zero), MEDIUM (Sales Manager only).
                                </div>
                                <field name="dealflow_risk_high_min"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
