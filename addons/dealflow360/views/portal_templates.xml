<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_dealflow_quotation" name="Portal My Home: Quotations link" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Quotations</t>
                <t t-set="url" t-value="'/my/quotations'"/>
                <t t-set="placeholder_count" t-value="'quotation_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_quotations" name="My Quotations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <t t-if="not orders">
                    <p class="alert alert-warning">There are no quotations to display.</p>
                </t>
                <t t-else="">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Quotation #</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="orders" t-as="order">
                                <td>
                                    <a t-attf-href="/my/quotation/#{order.id}">
                                        <t t-esc="order.name"/>
                                    </a>
                                </td>
                                <td><span t-field="order.date_order" t-options="{'widget': 'date'}"/></td>
                                <td>
                                    <span t-esc="order.df_pipeline_stage"
                                          t-attf-class="badge text-bg-#{'success' if order.df_pipeline_stage == 'confirmed' else 'info'}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-call="portal.pager"/>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_my_quotation_detail" name="Quotation Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="row">
                <div class="col-12">
                    <h3>
                        Quotation <t t-esc="order.name"/>
                        <span t-esc="order.df_pipeline_stage"
                              t-attf-class="badge text-bg-#{'success' if order.df_pipeline_stage == 'confirmed' else 'info'} ms-2"/>
                    </h3>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Discount</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="order.order_line" t-as="line">
                                <tr t-if="not line.display_type">
                                    <td><t t-esc="line.name"/></td>
                                    <td class="text-end"><t t-esc="line.product_uom_qty"/></td>
                                    <td class="text-end"><t t-esc="line.discount"/>%</td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total</strong></td>
                                <td class="text-end">
                                    <strong><span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <t t-if="order.state in ('draft', 'sent')">
                        <div class="card my-3">
                            <div class="card-body">
                                <h5>Propose a counter-discount</h5>
                                <form t-attf-action="/my/quotation/#{order.id}/counter" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="input-group" style="max-width: 320px;">
                                        <input type="number" step="0.01" min="0" max="100" name="counter_discount" class="form-control" placeholder="e.g. 12" required="required"/>
                                        <span class="input-group-text">%</span>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <form t-attf-action="/my/quotation/#{order.id}/confirm" method="post" class="mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-success">Confirm Quotation</button>
                        </form>
                    </t>

                    <div class="card my-3">
                        <div class="card-body">
                            <h5>Negotiation history</h5>
                            <t t-if="not negotiations">
                                <p class="text-muted">No counter-discount proposals yet.</p>
                            </t>
                            <ul class="list-group">
                                <li class="list-group-item" t-foreach="negotiations" t-as="neg">
                                    <t t-esc="neg.counter_discount"/>% proposed —
                                    <span t-esc="neg.state"/>
                                    <t t-if="neg.risk_level_after">
                                        (risk: <t t-esc="neg.risk_level_before"/> → <t t-esc="neg.risk_level_after"/>)
                                    </t>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="card my-3">
                        <div class="card-body">
                            <h5>Comments &amp; change requests</h5>
                            <form t-attf-action="/my/quotation/#{order.id}/comment" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-2">
                                    <select name="line_id" class="form-select">
                                        <option value="">General (not line-specific)</option>
                                        <t t-foreach="order.order_line" t-as="line">
                                            <option t-if="not line.display_type" t-att-value="line.id"><t t-esc="line.name"/></option>
                                        </t>
                                    </select>
                                </div>
                                <textarea name="message" class="form-control mb-2" rows="3" placeholder="Ask a question or request a change..." required="required"></textarea>
                                <button type="submit" class="btn btn-secondary">Send</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
