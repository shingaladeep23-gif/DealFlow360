<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_dealflow" model="ir.ui.view">
        <field name="name">product.template.form.dealflow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="DealFlow360" name="dealflow360">
                    <group>
                        <group string="Subscription">
                            <field name="df_is_recurring"/>
                            <!-- Every recurring behaviour keys off the PLAN, not
                                 off df_is_recurring: MRR, the next bill date and
                                 proration all read df_recurring_plan_id. It was
                                 missing from this form, so a product configured
                                 through the UI came out recurring with no plan
                                 and simply never billed. -->
                            <field name="df_recurring_plan_id"
                                   invisible="not df_is_recurring"
                                   required="df_is_recurring"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Upsell">
                            <field name="df_is_promoted"/>
                            <field name="df_min_margin"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_category_form_dealflow" model="ir.ui.view">
        <field name="name">product.category.form.dealflow</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="df_max_discount"/>
            </field>
        </field>
    </record>

    <record id="action_dealflow_product_template" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
