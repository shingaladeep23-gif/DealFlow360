<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DF-005b/DF-009: Screen 4 - Quotation Detail. Every field bound here
         already exists on main (df_effective_ceiling/df_excess_points/
         df_margin_pct on the line; df_margin_pct/df_blended_risk_score/
         df_risk_level/df_risk_summary on the order - see
         models/sale_order*.py). The upsell panel is bound to the always-
         present "id" field purely as an OWL widget mount point (see
         static/src/fields/upsell_panel/) - it is not a real editable
         field, just the cleanest way to embed a widget without a new
         model field. "Submit for Approval" is still not built (DF-004's
         API differs from what this brief originally assumed - see
         action_confirm's own routing instead). -->
    <record id="view_order_form_dealflow" model="ir.ui.view">
        <field name="name">sale.order.form.dealflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Line table: governance ceiling/excess and live margin,
                 right after the native discount column. Row turns red when
                 the rep's discount blows through df_effective_ceiling -
                 the mockup's "Status: Over Limit" is this decoration, not a
                 stored field (DEC-003 defines excess as the source of
                 truth; a separate status field would just be able to
                 drift out of sync with it). -->
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-danger">df_excess_points > 0</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="after">
                <field name="df_effective_ceiling" string="Limit (%)" optional="show"/>
                <field name="df_excess_points" string="Excess (pts)" optional="show"
                       decoration-danger="df_excess_points > 0"/>
                <field name="df_margin_pct" string="Margin (%)" optional="show"/>
            </xpath>

            <!-- Order-level summary: live margin + blended risk gauge, and
                 the flag banner explaining why (df_risk_summary is written
                 by the engine to be displayed as-is - DF-005 brief says use
                 it rather than re-deriving the sentence here). -->
            <xpath expr="//notebook" position="before">
                <div class="o_df_summary_group">
                    <div class="o_df_summary_card">
                        <div class="o_df_summary_label">Live Margin</div>
                        <div class="o_df_summary_value">
                            <field name="df_margin_pct" nolabel="1" digits="[1,1]"/>%
                        </div>
                    </div>
                    <div class="o_df_summary_card">
                        <div class="o_df_summary_label">Discount Risk</div>
                        <field name="df_risk_summary" invisible="1"/>
                        <field name="df_risk_level" invisible="1"/>
                        <field name="df_blended_risk_score" widget="dealflow_risk_gauge" nolabel="1"/>
                    </div>
                </div>
                <div class="o_df_flag_banner" invisible="not df_risk_summary">
                    <strong>⚠ </strong>
                    <field name="df_risk_summary" nolabel="1" readonly="1"/>
                    — flagged for approval.
                </div>
                <field name="id" widget="dealflow_upsell_panel" nolabel="1"/>
            </xpath>

            <!-- DF-017 Deal Health. The scoring engine, its four signals and
                 its cron all landed in 30bb7a0, but nothing in the frontend
                 ever read df_health_* - the feature existed only in Python
                 and was invisible to every user. This card is the missing
                 half: real stored values, plus a Refresh that runs the same
                 _compute_deal_health() the cron does, because two of the
                 four signals are functions of elapsed time and would
                 otherwise only ever change every six hours. -->
            <xpath expr="//notebook" position="before">
                <div class="o_df_health_card" invisible="not df_health_status">
                    <div class="o_df_health_head">
                        <div>
                            <div class="o_df_summary_label">Deal Health</div>
                            <div class="o_df_summary_value">
                                <field name="df_health_score" nolabel="1" readonly="1"/>/100
                            </div>
                        </div>
                        <field name="df_health_status" widget="label_selection" nolabel="1"
                               options="{'classes': {'healthy': 'success', 'at_risk': 'warning', 'critical': 'danger'}}"/>
                        <button name="action_df_refresh_health" type="object"
                                string="Refresh" class="btn btn-secondary btn-sm"/>
                    </div>
                    <field name="df_health_flags" widget="many2many_tags" nolabel="1" readonly="1"
                           invisible="not df_health_flags"/>
                    <div class="o_df_health_reason" invisible="not df_health_reason">
                        <field name="df_health_reason" nolabel="1" readonly="1"/>
                    </div>
                    <div class="o_df_health_since" invisible="not df_health_flagged_date">
                        Flagged since <field name="df_health_flagged_date" nolabel="1" readonly="1"/>
                    </div>
                </div>
            </xpath>

            <!-- Full detail tab kept for anyone auditing the raw governance
                 fields (QA, admins) alongside the compact summary above. -->
            <xpath expr="//notebook" position="inside">
                <page string="DealFlow360" name="dealflow360">
                    <group>
                        <field name="df_margin_pct"/>
                        <field name="df_pipeline_stage"/>
                        <field name="df_blended_risk_score"/>
                        <field name="df_risk_level"/>
                        <field name="df_risk_summary"/>
                    </group>
                    <group string="Deal Health (DF-017)">
                        <field name="df_health_score"/>
                        <field name="df_health_status"/>
                        <field name="df_health_flags" widget="many2many_tags"/>
                        <field name="df_health_reason"/>
                        <field name="df_health_flagged_date"/>
                        <field name="df_last_activity"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
