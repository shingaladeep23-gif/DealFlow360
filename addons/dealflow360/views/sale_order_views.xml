<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation detail (Screen 4).

         Design rule for this screen: a salesperson should be able to answer
         three questions without training or a glossary -
             "Am I making money?"        -> Margin
             "Can I just send this?"     -> Discount status
             "Is this deal in trouble?"  -> Deal health
         so the three summary cards below answer exactly those, in that order,
         and everything else is either a line-level number or lives in the
         Deal Details tab. Field labels come from the model (see
         models/sale_order.py) and deliberately state consequences rather than
         internal severities - "Needs manager approval", not "Medium". -->
    <record id="view_order_form_dealflow" model="ir.ui.view">
        <field name="name">sale.order.form.dealflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Line table: the discount limit that applies to THIS line, how
                 far past it the rep has gone, and what margin is left. The row
                 turns red when the line is over its limit - the mockup's
                 "Status: Over Limit" is this decoration, not a stored field
                 (DEC-003 makes excess the source of truth; a separate status
                 field could only drift out of sync with it). -->
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-danger">df_excess_points &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="after">
                <field name="df_effective_ceiling" string="Max Discount %" optional="show"/>
                <field name="df_excess_points" string="Over By" optional="show"
                       decoration-danger="df_excess_points &gt; 0"/>
                <field name="df_margin_pct" string="Margin %" optional="show"/>
            </xpath>

            <!-- One summary strip, three cards of the same shape. These used
                 to be two differently-styled blocks (margin/risk in one,
                 health in another), which read as two unrelated features
                 rather than one status line for the deal. -->
            <xpath expr="//notebook" position="before">
                <field name="df_risk_summary" invisible="1"/>
                <field name="df_risk_level" invisible="1"/>
                <field name="df_health_reason" invisible="1"/>

                <div class="o_df_summary_group">
                    <div class="o_df_summary_card">
                        <div class="o_df_summary_label">Margin</div>
                        <div class="o_df_summary_value">
                            <field name="df_margin_pct" nolabel="1" digits="[1,1]"/>%
                        </div>
                        <div class="o_df_summary_hint">Revenue left after product cost</div>
                    </div>

                    <div class="o_df_summary_card">
                        <div class="o_df_summary_label">Discount</div>
                        <field name="df_blended_risk_score" widget="dealflow_risk_gauge" nolabel="1"/>
                        <div class="o_df_summary_hint">
                            <field name="df_risk_level" nolabel="1" readonly="1"/>
                        </div>
                    </div>

                    <div class="o_df_summary_card">
                        <div class="o_df_summary_label">Deal Health</div>
                        <div class="o_df_summary_value" invisible="not df_health_status">
                            <field name="df_health_score" nolabel="1" readonly="1"/><span class="o_df_summary_unit">/100</span>
                        </div>
                        <div class="o_df_summary_value o_df_summary_muted" invisible="df_health_status">—</div>
                        <div class="o_df_summary_hint">
                            <field name="df_health_status" widget="label_selection" nolabel="1"
                                   options="{'classes': {'healthy': 'success', 'at_risk': 'warning', 'critical': 'danger'}}"
                                   invisible="not df_health_status"/>
                            <span invisible="df_health_status">Not scored yet</span>
                            <button name="action_df_refresh_health" type="object"
                                    string="Check now" class="btn btn-link btn-sm o_df_inline_btn"/>
                            <button name="action_df_nudge" type="object"
                                    string="Nudge owner" class="btn btn-link btn-sm o_df_inline_btn"
                                    invisible="not df_health_status"/>
                            <button name="action_df_escalate" type="object"
                                    string="Escalate" class="btn btn-link btn-sm o_df_inline_btn"
                                    invisible="df_health_status not in ('at_risk', 'critical')"/>
                        </div>
                    </div>
                </div>

                <!-- What happens next, in plain words. The old banner showed
                     the engine's sentence and stopped there, leaving the rep
                     to work out the consequence; these say who has to sign. -->
                <div class="o_df_banner o_df_banner_warning"
                     invisible="df_risk_level != 'medium' or state in ['sale', 'done', 'cancel']">
                    <strong>Over the discount limit.</strong>
                    <span><field name="df_risk_summary" nolabel="1" readonly="1"/></span>
                    <span>Confirming will send it to a <strong>sales manager</strong> for approval
                    rather than confirming it.</span>
                </div>
                <div class="o_df_banner o_df_banner_danger"
                     invisible="df_risk_level != 'high' or state in ['sale', 'done', 'cancel']">
                    <strong>Well over the discount limit.</strong>
                    <span><field name="df_risk_summary" nolabel="1" readonly="1"/></span>
                    <span>Confirming will send it to a <strong>sales manager and then finance</strong>
                    for approval rather than confirming it.</span>
                </div>
                <div class="o_df_banner o_df_banner_info" invisible="not df_health_reason">
                    <strong>Needs attention.</strong>
                    <span><field name="df_health_reason" nolabel="1" readonly="1"/></span>
                </div>

                <field name="id" widget="dealflow_upsell_panel" nolabel="1"/>
            </xpath>

            <!-- Everything behind the summary, for anyone who wants the raw
                 numbers (QA, managers auditing a decision). Kept off the main
                 sheet so the default view stays short. -->
            <!-- B7: "one-time lines and recurring lines separately within the
                 same order", the upcoming billing schedule, and cancel/modify
                 controls. All of this existed in the engine; none of it was on
                 the order, so the only way to see a subscription was a global
                 list screen that could not show you THIS deal's hybrid split.
                 The page hides itself entirely on an order with no recurring
                 line, rather than showing two empty tables. -->
            <xpath expr="//notebook" position="inside">
                <page string="Subscriptions &amp; Billing" name="dealflow_billing"
                      invisible="not df_recurring_line_ids">
                    <group string="Recurring lines">
                        <field name="df_recurring_line_ids" nolabel="1" readonly="1">
                            <tree decoration-muted="df_sub_state == 'cancelled'"
                                  decoration-warning="df_sub_state == 'paused'">
                                <field name="product_id"/>
                                <field name="product_uom_qty" string="Qty"/>
                                <field name="price_subtotal" widget="monetary"/>
                                <field name="df_sub_state" string="Status" widget="badge"
                                       decoration-success="df_sub_state == 'active'"
                                       decoration-warning="df_sub_state == 'paused'"
                                       decoration-muted="df_sub_state == 'cancelled'"/>
                                <field name="df_sub_start_date" string="Started"/>
                                <field name="df_sub_next_bill_date" string="Next bill"/>
                                <field name="df_mrr" widget="monetary" string="MRR"/>
                                <field name="currency_id" column_invisible="1"/>
                                <button name="action_pause_subscription" type="object"
                                        string="Pause" icon="fa-pause"
                                        invisible="df_sub_state != 'active'"/>
                                <button name="action_resume_subscription" type="object"
                                        string="Resume" icon="fa-play"
                                        invisible="df_sub_state != 'paused'"/>
                                <button name="action_cancel_subscription" type="object"
                                        string="Cancel" icon="fa-times"
                                        confirm="Stop future billing for this subscription? If its plan issues credit notes, the unused part of the current period will be credited."
                                        invisible="df_sub_state not in ('active', 'paused')"/>
                            </tree>
                        </field>
                    </group>
                    <group string="One-time lines">
                        <field name="df_one_time_line_ids" nolabel="1" readonly="1">
                            <tree>
                                <field name="product_id"/>
                                <field name="product_uom_qty" string="Qty"/>
                                <field name="discount"/>
                                <field name="price_subtotal" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                            </tree>
                        </field>
                        <div class="o_df_screen_hint">
                            Billed by this order's own invoice. Recurring lines above are
                            billed on their own schedule instead, so Create Invoice never
                            charges for them twice.
                        </div>
                    </group>
                    <group string="Upcoming and past billing">
                        <field name="df_billing_schedule_ids" nolabel="1" readonly="1">
                            <tree decoration-muted="state == 'cancelled'"
                                  decoration-success="state == 'invoiced'">
                                <field name="date"/>
                                <field name="order_line_id" string="Subscription"/>
                                <field name="amount" widget="monetary"/>
                                <field name="df_is_proration" string="Proration"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'invoiced'"
                                       decoration-info="state == 'pending'"
                                       decoration-muted="state == 'cancelled'"/>
                                <field name="invoice_id"/>
                                <field name="currency_id" column_invisible="1"/>
                            </tree>
                        </field>
                    </group>
                </page>

                <!-- B4's "confirmation screen with a full audit trail entry",
                     and A3's requirement that approvals, rejections AND edits
                     be logged with user, timestamp and reason. The rows were
                     always written; nothing ever displayed them. -->
                <page string="Audit Trail" name="dealflow_audit"
                      invisible="not df_audit_log_ids">
                    <field name="df_audit_log_ids" nolabel="1" readonly="1">
                        <tree create="false" edit="false" delete="false"
                              decoration-danger="action == 'rejected'"
                              decoration-warning="action in ('revision_requested', 'superseded')"
                              decoration-success="action == 'approved'">
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="detail"/>
                        </tree>
                    </field>
                </page>

                <page string="Deal Details" name="dealflow360">
                    <group>
                        <group string="Discount &amp; approval">
                            <field name="df_pipeline_stage"/>
                            <field name="df_risk_level"/>
                            <field name="df_blended_risk_score"/>
                            <field name="df_risk_summary"/>
                            <field name="df_margin_pct"/>
                        </group>
                        <group string="Deal health">
                            <field name="df_health_score"/>
                            <field name="df_health_status"/>
                            <field name="df_health_flags" widget="many2many_tags"/>
                            <field name="df_health_reason"/>
                            <field name="df_health_flagged_date"/>
                            <field name="df_last_activity"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
