<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A7 / flow step 12: reporting with the four required filters and
         export. This was the one whole section of the problem statement with
         nothing behind it at all - menu_dealflow_reports sat at active="0"
         and task_plan.md still marked DF-018 as not started.

         Built on native pivot/graph/list over sale.order rather than a custom
         OWL screen: Odoo's own "Download xlsx" on the pivot and list covers
         A7's XLS export for free, and the four Reporting Filters map onto real
         stored fields. PDF is the native quotation report on an individual
         order - this deliberately does not claim a bespoke PDF it does not
         have. Product/Category is a separate action over sale.order.line,
         because that dimension does not exist at order level. -->

    <record id="view_dealflow_report_pivot" model="ir.ui.view">
        <field name="name">sale.order.dealflow.report.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Sales Performance" sample="1">
                <field name="user_id" type="row"/>
                <field name="df_risk_level" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="df_margin_pct" type="measure"/>
                <field name="df_blended_risk_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dealflow_report_graph" model="ir.ui.view">
        <field name="name">sale.order.dealflow.report.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Sales Performance" type="bar" sample="1">
                <field name="user_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dealflow_report_tree" model="ir.ui.view">
        <field name="name">sale.order.dealflow.report.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Sales Performance" create="false">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="user_id" string="Rep"/>
                <field name="team_id" string="Team" optional="show"/>
                <field name="state"/>
                <field name="df_approval_state" string="Approval"/>
                <field name="df_risk_level" string="Discount"/>
                <field name="df_margin_pct" string="Margin %" optional="show"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dealflow_report_search" model="ir.ui.view">
        <field name="name">sale.order.dealflow.report.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Sales Reporting">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>

                <!-- A7 filter 1: Period -->
                <filter name="period_today" string="Today"
                        domain="[('date_order', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="period_week" string="Last 7 Days"
                        domain="[('date_order', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="period_month" string="Last 30 Days"
                        domain="[('date_order', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="period_custom" string="Order Date" date="date_order"/>
                <separator/>

                <!-- A7 filter 3: Approval Status -->
                <filter name="approval_pending" string="Pending approval"
                        domain="[('df_approval_state', '=', 'pending')]"/>
                <filter name="approval_approved" string="Approved"
                        domain="[('df_approval_state', '=', 'approved')]"/>
                <filter name="approval_rejected" string="Rejected"
                        domain="[('df_approval_state', '=', 'rejected')]"/>
                <filter name="approval_none" string="Never needed approval"
                        domain="[('df_approval_id', '=', False)]"/>
                <separator/>
                <filter name="over_limit" string="Over the discount limit"
                        domain="[('df_risk_level', 'in', ('medium', 'high'))]"/>

                <group expand="0" string="Group By">
                    <!-- A7 filter 2: Sales Team / Rep -->
                    <filter name="group_rep" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Sales Team"
                            context="{'group_by': 'team_id'}"/>
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_approval" string="Approval Status"
                            context="{'group_by': 'df_approval_state'}"/>
                    <filter name="group_risk" string="Discount Status"
                            context="{'group_by': 'df_risk_level'}"/>
                    <filter name="group_month" string="Order Month"
                            context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dealflow_report_orders" model="ir.actions.act_window">
        <field name="name">Sales Performance</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="search_view_id" ref="view_dealflow_report_search"/>
        <!-- view_ids, not views: `views` is compute-only on this build and an
             eval write to it silently no-ops (see the comment in
             sale_order_kanban_views.xml). -->
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'pivot', 'view_id': ref('view_dealflow_report_pivot')}),
            (0, 0, {'sequence': 2, 'view_mode': 'graph', 'view_id': ref('view_dealflow_report_graph')}),
            (0, 0, {'sequence': 3, 'view_mode': 'tree', 'view_id': ref('view_dealflow_report_tree')}),
            (0, 0, {'sequence': 4, 'view_mode': 'form'})]"/>
    </record>

    <!-- A7 filter 4: Product / Category. Lives at line level because an order
         has no single product. "Most discounted items" is the discount measure
         here, "best selling" the quantity/total. -->
    <record id="view_dealflow_report_line_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.dealflow.report.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Products" sample="1">
                <field name="product_id" type="row"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="price_subtotal" type="measure"/>
                <field name="discount" type="measure"/>
                <field name="df_excess_points" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dealflow_report_line_search" model="ir.ui.view">
        <field name="name">sale.order.line.dealflow.report.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Product Reporting">
                <field name="product_id"/>
                <field name="order_id"/>
                <filter name="over_limit" string="Discounted past its limit"
                        domain="[('df_excess_points', '&gt;', 0)]"/>
                <filter name="period_month" string="Last 30 Days"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_salesperson" string="Salesperson"
                            context="{'group_by': 'salesman_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dealflow_report_products" model="ir.actions.act_window">
        <field name="name">Products and Categories</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">pivot,tree</field>
        <field name="search_view_id" ref="view_dealflow_report_line_search"/>
        <field name="domain">[('display_type', '=', False), ('product_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'pivot', 'view_id': ref('view_dealflow_report_line_pivot')}),
            (0, 0, {'sequence': 2, 'view_mode': 'tree'})]"/>
    </record>

    <!-- Re-enable the menu that was parked at active="0" with the comment
         "DF-017/018 are not implemented". -->
    <menuitem id="menu_dealflow_reports" name="Reports" parent="menu_dealflow_root"
              sequence="80" active="1"
              groups="group_dealflow_sales_rep,group_dealflow_finance"/>
    <menuitem id="menu_dealflow_report_orders" name="Sales Performance"
              parent="menu_dealflow_reports"
              action="action_dealflow_report_orders" sequence="10"
              groups="group_dealflow_sales_rep,group_dealflow_finance"/>
    <menuitem id="menu_dealflow_report_products" name="Products and Categories"
              parent="menu_dealflow_reports"
              action="action_dealflow_report_products" sequence="20"
              groups="group_dealflow_sales_rep,group_dealflow_finance"/>
</odoo>
