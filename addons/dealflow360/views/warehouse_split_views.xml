<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DF-011 (minimal, backend-owned): Screens 5/6 need a real click-path
         to demo DF-010's allocation engine before Don's polished OWL
         dashboard lands. Kept intentionally plain - Don may still replace
         this with the two-table OWL screen from docs/ui_spec.md without
         touching any DF-010 model or logic. -->

    <!-- 2026-09-05 frontend pass: Screen 5 detail. Recommendation banner
         and backorder badge are pure presentation over existing fields
         (shipment_count/has_backorder/state) - no new field, per DEC-006
         Don's ui_spec.md already flagged df_recommendation_note as
         optional/not required. -->
    <record id="view_dealflow_warehouse_split_form" model="ir.ui.view">
        <field name="name">dealflow.warehouse.split.form</field>
        <field name="model">dealflow.warehouse.split</field>
        <field name="arch" type="xml">
            <form string="Fulfillment">
                <header>
                    <button name="action_generate_split" type="object" string="Regenerate Suggestion"
                            invisible="state == 'confirmed'"/>
                    <button name="action_confirm" type="object" string="Accept Suggested Split"
                            class="btn-primary" invisible="state == 'confirmed'"/>
                    <button name="action_consolidate_backorder" type="object" string="Consolidate Backorder"
                            class="btn-primary" invisible="not df_can_consolidate"/>
                    <button name="action_consolidate_backorder" type="object" string="Consolidate Backorder"
                            invisible="state != 'confirmed' or not has_backorder or df_can_consolidate"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="order_id" readonly="1"/>
                        </h1>
                    </div>
                    <group col="4">
                        <field name="partner_id" readonly="1"/>
                        <field name="shipment_count" readonly="1" string="Est. Shipments"/>
                        <field name="df_estimated_shipping_cost" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="has_backorder" readonly="1" invisible="1"/>
                        <field name="df_can_consolidate" invisible="1"/>
                        <field name="df_consolidatable_qty" invisible="1"/>
                    </group>
                    <div class="o_df_flag_banner" invisible="shipment_count &lt;= 1 or has_backorder">
                        Recommended allocation combines shipments where possible to minimize shipping cost and lead time.
                    </div>
                    <!-- B6's automatic prompt. df_can_consolidate is a live
                         compute over real stock.quant, so this banner is
                         correct the moment the screen is opened rather than
                         waiting for anyone to press anything. -->
                    <div class="o_df_flag_banner o_df_flag_banner_action" invisible="not df_can_consolidate">
                        Stock has arrived: <field name="df_consolidatable_qty" readonly="1" class="oe_inline"/> unit(s) of this backorder can be shipped now. Use "Consolidate Backorder" to release them.
                    </div>
                    <div class="o_df_flag_banner" invisible="not has_backorder or df_can_consolidate">
                        Part of this order cannot be sourced from current stock and is on backorder. This banner will change as soon as stock arrives that can clear it.
                    </div>
                    <!-- AT-06's manual override. Editing a row IS the
                         override - action_confirm materializes whatever is on
                         line_ids and never recomputes the suggestion - but the
                         screen never said so, and the spec names the capability
                         explicitly, so a reviewer looking for it found an
                         unlabelled editable table and no "Manual Override"
                         anywhere. Naming it costs nothing and beats adding a
                         button that would only toggle what is already true. -->
                    <separator string="Allocation — manual override" invisible="state == 'confirmed'"/>
                    <div class="text-muted mb-2" invisible="state == 'confirmed'">
                        This is the system's suggestion. Change any warehouse or quantity below to
                        override it — "Accept Suggested Split" ships exactly what these rows say,
                        not what was originally proposed.
                    </div>
                    <field name="line_ids" readonly="state == 'confirmed'">
                        <tree string="Allocation" editable="bottom" decoration-warning="is_backorder">
                            <field name="product_id" readonly="1"/>
                            <field name="warehouse_id"/>
                            <field name="qty"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="df_estimated_cost" string="Est. Shipping Cost" sum="Est. Shipping Cost"/>
                            <field name="is_backorder" widget="boolean_toggle"/>
                        </tree>
                    </field>
                    <field name="picking_ids" readonly="1">
                        <tree string="Deliveries">
                            <field name="name"/>
                            <field name="picking_type_id"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dealflow_fulfillment" model="ir.actions.client">
        <field name="name">Fulfillment</field>
        <field name="tag">dealflow_fulfillment</field>
    </record>

    <!-- Finance is listed because section 3 gives it "warehouse fulfillment
         splits and backorder decisions". It could read every split and every
         picking and had no way to navigate to any of them - group_dealflow_finance
         does not imply group_dealflow_sales_rep, so a rep-only menu is
         invisible to it. -->
    <menuitem id="menu_dealflow_fulfillment" name="Fulfillment" parent="menu_dealflow_root"
              action="action_dealflow_fulfillment" sequence="40"
              groups="group_dealflow_sales_rep,group_dealflow_finance"/>
</odoo>
