<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_dealflow360" model="ir.module.category">
            <field name="name">DealFlow360</field>
            <field name="description">Access levels for the DealFlow360 sales operations platform.</field>
            <field name="sequence">20</field>
        </record>

        <!-- stock.group_stock_user: a rep owns the deliveries their orders
             generate. Without any Inventory group, every stock.picking the
             DF-010 split engine creates is unreadable to the person whose
             order created it, and the Fulfillment screen's links to them
             raise AccessError. This is operating on stock, not configuring
             it - warehouse/replenishment setup stays with Admin per
             section 3. -->
        <record id="group_dealflow_sales_rep" model="res.groups">
            <field name="name">Sales Rep</field>
            <field name="category_id" ref="module_category_dealflow360"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Builds quotations, submits for approval, negotiates with customers.</field>
        </record>

        <record id="group_dealflow_sales_manager" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="category_id" ref="module_category_dealflow360"/>
            <!-- sales_team.group_sale_manager is the Sales app's own "Administrator"
                 level (full CRM/Sales access) - it is NOT base.group_system and
                 grants no wider Odoo admin/superuser rights. -->
            <field name="implied_ids" eval="[(4, ref('group_dealflow_sales_rep')), (4, ref('sales_team.group_sale_manager'))]"/>
            <field name="comment">First approval step for MEDIUM and HIGH risk quotations.</field>
        </record>

        <!-- stock.group_stock_user: section 3 gives Finance "warehouse
             fulfillment splits and backorder decisions". It held no Inventory
             group at all, so it could read the split data and then do nothing
             with it - consolidating a backorder raised an AccessError. -->
        <record id="group_dealflow_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="category_id" ref="module_category_dealflow360"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Second approval step for HIGH risk quotations; owns billing, invoicing and backorder decisions.</field>
        </record>

        <!-- Section 3: "Admin - manages backend setup: users, roles,
             products, warehouses." Every one of those is gated by a native
             Odoo group this role did not hold, so A4 in its entirety was
             unreachable by ANY business-facing role: all four personas had
             write denied on stock.warehouse, stock.warehouse.orderpoint and
             stock.quant, the Warehouses screen rendered "Shipping Cost
             Weight: 1.00" as read-only text, Replenishment Rules was empty
             with no way to add one, and only a raw Odoo superuser outside the
             role model could touch any of it.

             base.group_system is deliberate rather than incidental. Managing
             USERS AND ROLES is res.users write, and saving a res.config.settings
             panel is gated on base.group_system by Odoo itself
             (`if not self.env.is_admin(): raise AccessError`) - which is the
             exact reason df.admin got an AccessError saving the governance
             thresholds. This role IS the backend administrator; the other
             three are not, and none of them imply it.

             The product groups are what make A2's variants and price lists
             visible at all - without them those menus do not render, however
             much catalogue data exists behind them. -->
        <record id="group_dealflow_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_dealflow360"/>
            <field name="implied_ids" eval="[(4, ref('group_dealflow_sales_manager')),
                                             (4, ref('group_dealflow_finance')),
                                             (4, ref('base.group_system')),
                                             (4, ref('stock.group_stock_manager')),
                                             (4, ref('stock.group_stock_multi_warehouses')),
                                             (4, ref('stock.group_stock_multi_locations')),
                                             (4, ref('product.group_product_variant')),
                                             (4, ref('product.group_product_pricelist'))]"/>
            <field name="comment">Backend setup: users, roles, products, warehouses, tiers, category limits and subscription plans.</field>
        </record>

        <!-- DEC-012: GLOBAL rule (no groups_id) - group rules OR together in
             Odoo, so a rule scoped to the portal group would widen access
             instead of narrowing it. Only a global rule genuinely restricts.
             Ownership-based (partner_id / commercial partner + children), not
             follower-based - deliberately not reusing Odoo's native
             follower-scoped "Portal Personal Sales Orders" rule (DEC-007).

             P0 fix: a GLOBAL rule ANDs against every non-superuser, internal
             staff included, so without an exemption a Sales Manager could
             read zero quotations (own commercial partner is never the
             customer's). Gate on user.share (true only for portal/public
             users) so internal users are unaffected by this rule and portal
             users stay locked to their own records - domain_force is eval'd
             as Python with `user` in scope, so the conditional is legitimate.

             The state term is the second half of the ownership question: WHICH
             of my own quotations am I entitled to see? A quotation in 'draft'
             is the rep's private working copy - it has not been sent to
             anybody. Live-reproduced bug: the portal listed 18 unsent internal
             drafts to the customer, and a customer opened one the rep had
             never sent (S00055, state='draft') and pressed Confirm, taking it
             straight to 'sale'. Excluding draft HERE rather than only in
             controllers/portal.py closes it for every read path at once -
             our own portal screens, Odoo's native /my/quotes and /my/orders,
             and any ORM read a portal user could otherwise reach. The
             controller still checks state on the write routes; this is the
             layer that makes the record invisible in the first place.

             A quotation becomes customer-visible the moment it is genuinely
             released: the rep sends it, or an approval chain completes and
             sale.order._df_on_approval_granted() marks it sent. -->
        <record id="rule_dealflow_portal_sale_order_own" model="ir.rule">
            <field name="name">DealFlow360: portal users see only their own, released quotations</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['&amp;', ('partner_id', 'child_of', [user.commercial_partner_id.id]), ('state', '!=', 'draft')] if user.share else [(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Portal users never write sale.order/dealflow.negotiation directly
             from the ORM - every mutation (counter-discount, confirm) is
             mediated by controllers/portal.py, which validates the business
             rule then writes via sudo(). perm_read=1 only: this rule's job is
             to narrow which rows a read-only ORM access can see. -->
        <record id="rule_dealflow_portal_negotiation_own" model="ir.rule">
            <field name="name">DealFlow360: portal users see only their own negotiations</field>
            <field name="model_id" ref="model_dealflow_negotiation"/>
            <!-- Same P0 fix as the sale.order rule above: this is also a
                 GLOBAL rule, so without the user.share gate it would also
                 hide every negotiation from internal staff. -->
            <field name="domain_force">[('order_id.partner_id', 'child_of', [user.commercial_partner_id.id])] if user.share else [(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- DEC-018 (amends DEC-012). Live-verified bug: `sale`'s own portal
             rules ("Portal Personal Quotations/Sales Orders" on sale.order,
             "Portal Sales Orders Line" on sale.order.line) are FOLLOWER-based
             (message_partner_ids), scoped to the portal GROUP. Group rules OR
             together, but the combined group-term is still ANDed against our
             GLOBAL partner_id rule above - so a quotation the customer is not
             yet a chatter follower of (i.e. every quotation created via plain
             ORM create(), never explicitly "sent") was unreadable even to its
             own owner. Not a security hole (cross-customer access still fails
             every test - see test_portal_isolation.py); it silently broke the
             portal for every legitimate customer.

             Fix: add our OWN partner_id-based rule to the SAME portal group,
             not global. Combination becomes:
                 (our global partner rule)
                 AND (native follower rule OR this new partner rule)
             which reduces to exactly "our global partner rule" (A AND (B OR A)
             == A) - this cannot widen access beyond what the global rule
             already allows, it only stops the narrower native rule from being
             the sole (and wrong) gate. Never modifies/replaces the native
             rule (DEC-012 still rejects that), only adds alongside it. -->
        <record id="rule_dealflow_portal_sale_order_own_group" model="ir.rule">
            <field name="name">DealFlow360: portal group companion so the native follower-based rule can't block real owners</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_dealflow_portal_sale_order_line_own_group" model="ir.rule">
            <field name="name">DealFlow360: portal group companion for sale.order.line (same reasoning)</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- The Fulfillment list must not offer rows the viewer cannot open.
             dealflow.warehouse.split carried no record rule at all, while the
             sale.order behind it is still scoped by Odoo's own "Own Documents
             Only" rule for a salesperson - so the list showed every split in
             the database and clicking one belonging to another rep's order
             raised a hard Access Error modal on drill-down. Live-reproduced as
             df.rep: 16 splits listed, S00066 unopenable. It only looked rare
             because there is effectively one rep in the demo data; with a real
             team it would fire constantly.

             These mirror Odoo's sale.order rules rather than inventing a new
             scope: sales_team.group_sale_salesman is "own documents only" and
             group_sale_salesman_all_leads is "all". Group rules OR together,
             so a Sales Manager (who holds both) sees everything and a rep sees
             their own. Finance holds neither sales group, so no rule applies
             to it and it keeps the full visibility section 3 requires for
             backorder decisions. -->
        <record id="rule_dealflow_split_own_documents" model="ir.rule">
            <field name="name">DealFlow360: a salesperson sees fulfillment splits for their own orders</field>
            <field name="model_id" ref="model_dealflow_warehouse_split"/>
            <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="rule_dealflow_split_all_documents" model="ir.rule">
            <field name="name">DealFlow360: a sales manager sees every fulfillment split</field>
            <field name="model_id" ref="model_dealflow_warehouse_split"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
        <record id="rule_dealflow_split_line_own_documents" model="ir.rule">
            <field name="name">DealFlow360: allocation lines follow their split</field>
            <field name="model_id" ref="model_dealflow_warehouse_split_line"/>
            <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="rule_dealflow_split_line_all_documents" model="ir.rule">
            <field name="name">DealFlow360: a sales manager sees every allocation line</field>
            <field name="model_id" ref="model_dealflow_warehouse_split_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
    </data>
</odoo>
